# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SerpApi Google Flights API (Optional: Mock provider used if omitted)
SERPAPI_API_KEY=your-serpapi-key

# Nodemailer / Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password

# Admin Emails (comma-separated, case-insensitive)
ADMIN_EMAILS=admin@example.com

# Cron Job Secret Header (Bearer or header validation)
CRON_SECRET=your-random-cron-secret-32-chars

# App URL for absolute links in emails (e.g., http://localhost:3000 or https://farewatch.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
